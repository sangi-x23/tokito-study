# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.

# ── Neon · Fase 1 ────────────────────────────────────────────────────
# Conexión POOLED. El host termina en `-pooler`.
# La usa el runtime a través de @prisma/adapter-neon.
DATABASE_URL=

# Conexión DIRECTA: mismo host, pero SIN `-pooler`.
# La usan las migraciones desde prisma.config.ts, porque PgBouncer no
# soporta las sentencias que ejecuta `prisma migrate`.
DIRECT_URL=

# ── Google Docs · Fase 2 ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ID del Google Doc del curso. Nunca en el código ni en el repo.
GOOGLE_DOC_ID=

# ── Gemini · Fase 3 ──────────────────────────────────────────────────
GEMINI_API_KEY=

# Modelo Flash disponible en el nivel gratuito. El identificador exacto se
# confirma listando los modelos de la API en la Fase 3, no de memoria.
GEMINI_MODEL=

# ── Ingesta · Fase 5 ─────────────────────────────────────────────────
# Protege los endpoints de escritura: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TopicCategory {
  GRAMMAR
  VOCABULARY
  KANJI
  EXPRESSION
  OTHER
}

enum ItemType {
  WORD
  KANJI
  GRAMMAR_POINT
  PHRASE
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// El Google Doc del curso
model SourceDocument {
  id           String    @id @default(cuid())
  googleDocId  String    @unique
  title        String
  lastRevision String?
  sections     Section[]
  updatedAt    DateTime  @updatedAt
}

// Una pestaña del documento = una clase
model Section {
  id          String           @id @default(cuid())
  documentId  String
  document    SourceDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tabId       String
  title       String
  classDate   DateTime?
  position    Int
  contentHash String
  rawText     String
  processedAt DateTime?
  occurrences ItemOccurrence[]

  @@unique([documentId, tabId])
}

// Taxonomía jerárquica: tema -> subtema
model Topic {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  category    TopicCategory
  position    Int           @default(0)
  parentId    String?
  parent      Topic?        @relation("TopicTree", fields: [parentId], references: [id])
  children    Topic[]       @relation("TopicTree")
  items       ItemTopic[]

  @@index([parentId])
}

// Átomo del sistema: existe una sola vez aunque aparezca en varias clases
model StudyItem {
  id          String           @id @default(cuid())
  type        ItemType
  japanese    String
  reading     String?
  meaning     String
  example     String?
  topics      ItemTopic[]
  occurrences ItemOccurrence[]

  @@unique([type, japanese])
}

// Un ítem puede vivir en varios temas a la vez: 日 pertenece tanto a
// "Fechas y calendario" como a un tema de categoría KANJI para practicarlo.
// La ingesta debe garantizar al menos un tema por ítem (el schema no lo exige).
model ItemTopic {
  itemId    String
  item      StudyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  topicId   String
  // Restrict: borrar un tema con ítems obliga a reasignarlos primero,
  // en vez de perder la clasificación en silencio.
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Restrict)
  // Tema canónico del ítem: el que se usa para breadcrumbs y para listarlo
  // una sola vez en vistas planas.
  isPrimary Boolean   @default(false)
  // Orden del ítem dentro de este tema
  position  Int       @default(0)

  @@id([itemId, topicId])
  @@index([topicId])
}

// En qué clases apareció cada ítem
model ItemOccurrence {
  itemId    String
  item      StudyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([itemId, sectionId])
  @@index([sectionId])
}

// Caché de imágenes procesadas (se guarda solo el texto extraído)
model ImageAsset {
  hash          String   @id // SHA-256 del contenido
  extractedText String
  createdAt     DateTime @default(now())
}

// Registro de corridas de ingesta; RUNNING actúa como candado
model IngestionRun {
  id                String    @id @default(cuid())
  status            RunStatus
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  sectionsProcessed Int       @default(0)
  error             String?
}

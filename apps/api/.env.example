# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.

# ── Servidor ─────────────────────────────────────────────────────────
# Opcional. Por defecto 3001. En Vercel lo inyecta la plataforma.
PORT=

# ── Neon · Fase 1 ────────────────────────────────────────────────────
# Conexión POOLED. El host termina en `-pooler`.
# La usa el runtime a través de @prisma/adapter-neon.
DATABASE_URL=

# Conexión DIRECTA: mismo host, pero SIN `-pooler`.
# La usan las migraciones desde prisma.config.ts, porque PgBouncer no
# soporta las sentencias que ejecuta `prisma migrate`.
DIRECT_URL=

# ── Google Docs · Fase 2 ─────────────────────────────────────────────
# JSON de la cuenta de servicio, codificado en base64 en una sola línea.
# Para generarlo desde PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("clave.json"))
#
# Va en base64 y en una sola variable porque la clave privada trae saltos de
# línea reales, que se rompen al copiarlos entre el .env y el panel de Vercel.
GOOGLE_SERVICE_ACCOUNT_KEY=

# El Google Doc del curso: acepta el ID pelado o la URL completa.
# Nunca en el código ni en el repo.
GOOGLE_DOC_ID=

# Opcional. Pestañas que no son clases (temario, lista y notas), separadas
# por coma. Se leen solo para sacar los nombres a descartar; no se procesan.
# El tabId sale en `pnpm docs:print` o en la URL (`?tab=t.0`).
GOOGLE_DOC_SKIP_TABS=

# Opcional. Términos que el descarte de datos personales no detecta solo
# (un diminutivo, el negocio o el trabajo de alguien), separados por coma.
# Se quita toda línea que los contenga. Son datos personales: solo aquí y en
# el panel de Vercel, nunca en el repo.
GOOGLE_DOC_PERSONAL_TERMS=

# ── Gemini · Fase 3 ──────────────────────────────────────────────────
GEMINI_API_KEY=

# Modelo Flash disponible en el nivel gratuito, ej. gemini-3.5-flash.
# Se elige listando los modelos con la clave, no de memoria:
#   GET https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=

# Opcionales. Separación mínima entre llamadas (por defecto 7000 ms) y
# reintentos ante 429 por minuto o errores 5xx (por defecto 4). Los límites
# reales del proyecto se ven en AI Studio; no están publicados.
GEMINI_MIN_INTERVAL_MS=
GEMINI_MAX_RETRIES=

# ── Ingesta · Fase 5 ─────────────────────────────────────────────────
# Protege el endpoint de ingesta: Authorization: Bearer <CRON_SECRET>.
# Al menos 16 caracteres. Vercel Cron lo manda solo si la variable existe en
# el proyecto. Para generarlo: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=
